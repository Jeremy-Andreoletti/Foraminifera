#1 - Describe the name of your executable, and the optional arguments
executable = /usr/local/bin/julia
universe = vanilla
accounting_group = LongJob.Unlimited
notification = complete

#2 - Describe the name of the files where the stdout, stderr and log of your job should get redirected:
error = /data/biodiv/andreole/Forams/5-Analyses/4-OBDD/Logs/NonSpinose_OBDD.$(Cluster).$(Process).stderr
log = /data/biodiv/andreole/Forams/5-Analyses/4-OBDD/Logs/NonSpinose_OBDD.$(Cluster).$(Process).log

#3 - Describe the resources requirements of your job : 
request_memory = 3 GB
request_cpus = 1

#4 - Submit your job
arguments = /data/biodiv/andreole/Forams/5-Analyses/4-OBDD/Forams_extant_NonSpinose_OBDD.jl $(seed)

queue seed from seq 0 4 |
